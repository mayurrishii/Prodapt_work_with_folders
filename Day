/**
 * db.js — Simple JSON-file DB with a two-file transaction / rollback pattern.
 *
 * Every write follows this sequence:
 *   1. Read fresh state from both files (inventory + bookings)
 *   2. Apply in-memory changes
 *   3. Write inventory FIRST (to a temp file → rename = atomic)
 *   4. Write bookings SECOND
 *   5. If step 3 fails → rollback (restore originals); never touch bookings
 *   6. If step 4 fails → rollback inventory to its pre-write state
 *
 * writeState accepts an optional rollback function that it invokes if the
 * write fails — so route handlers never need a try/catch block at all.
 */

const fs = require('fs');
const path = require('path');
const { InternalError, NotFoundError } = require('./errors');

const INVENTORY_PATH = path.join(__dirname, 'seeds-inventory.json');
const BOOKINGS_PATH = path.join(__dirname, 'bookings.json');
const INVENTORY_TEMP = path.join(__dirname, 'seeds-inventory.tmp.json');
const BOOKINGS_TEMP = path.join(__dirname, 'bookings.tmp.json');

// ── helpers ──────────────────────────────────────────────

function readJSON(filePath) {
  const raw = fs.readFileSync(filePath, 'utf-8');
  return JSON.parse(raw);
}

function atomicWrite(targetPath, tempPath, data) {
  fs.writeFileSync(tempPath, JSON.stringify(data, null, 2), 'utf-8');
  fs.renameSync(tempPath, targetPath);
}

// ── public API ───────────────────────────────────────────

/**
 * Read the latest state from both files.
 * @returns {{ inventory: object[], bookings: object[] }}
 * @throws {InternalError} on read failures
 */
function readState() {
  try {
    const inventory = readJSON(INVENTORY_PATH);
    const bookings = readJSON(BOOKINGS_PATH);
    return { inventory, bookings };
  } catch (err) {
    throw new InternalError('Failed to read database files', err.message);
  }
}

/**
 * Atomically persist both files. If a write fails the other is rolled back.
 *
 * @param {object[]} inventory
 * @param {object[]} bookings
 * @param {Function} [onRollback] — called AFTER in-memory rollback completes, if write fails.
 *        The function receives the original AppError so it can log or re-throw.
 *        Route handlers can pass a rollback lambda here — eliminating the need
 *        for try/catch in the handler itself.
 * @throws {AppError} with statusCode 500 on write failures
 */
function writeState(inventory, bookings, onRollback) {
  let invBackup, bkBackup;
  try {
    invBackup = readJSON(INVENTORY_PATH);
    bkBackup = readJSON(BOOKINGS_PATH);
  } catch (_) {
    // proceed without backup — rollback won't be possible
  }

  try {
    atomicWrite(INVENTORY_PATH, INVENTORY_TEMP, inventory);
  } catch (err) {
    const appErr = new InternalError('Failed to write inventory', err.message);
    if (onRollback) onRollback(appErr);
    throw appErr;
  }

  try {
    atomicWrite(BOOKINGS_PATH, BOOKINGS_TEMP, bookings);
  } catch (err) {
    if (invBackup) {
      try {
        atomicWrite(INVENTORY_PATH, INVENTORY_TEMP, invBackup);
      } catch (rollbackErr) {
        const critical = new InternalError(
          'CRITICAL: inventory written but bookings failed AND rollback failed. ' +
          'Inventory may be corrupt.',
          `${err.message} | Rollback: ${rollbackErr.message}`
        );
        if (onRollback) onRollback(critical);
        throw critical;
      }
    }

    const appErr = new InternalError('Booking write failed, inventory rolled back', err.message);
    if (onRollback) onRollback(appErr);
    throw appErr;
  }

  // Cleanup temp files (best-effort)
  try { fs.unlinkSync(INVENTORY_TEMP); } catch (_) { /* ignore */ }
  try { fs.unlinkSync(BOOKINGS_TEMP); } catch (_) { /* ignore */ }
}

/**
 * Find a show (inventory record) by movieName + showTime.
 * @throws {NotFoundError} if not found
 */
function findShowOrThrow(inventory, movieName, showTime) {
  const show = inventory.find(
    s => s.movieName === movieName && s.showTime === showTime
  );
  if (!show) {
    throw new NotFoundError(
      'Show not found',
      `No show found for "${movieName}" at "${showTime}"`
    );
  }
  return show;
}

module.exports = { readState, writeState, findShowOrThrow };